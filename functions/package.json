{
  "name": "grua-rd-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Grúas RD 24/7 — dispatch, service lifecycle, payments.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --only firestore,database,auth,storage \"vitest run --mode emulator\"",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.2",
    "geofire-common": "^6.0.0",
    "livekit-server-sdk": "^2.19.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^20.17.12",
    "eslint": "^9.39.5",
    "firebase": "^12.19.0",
    "globals": "^17.12.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}

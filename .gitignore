# ---- Dart / Flutter ----
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/doc/api/
*.iml
.idea/
.vscode/
*.log

# Workspace resolves at the root only.
packages/*/pubspec.lock
apps/*/pubspec.lock

# ---- Generated code ----
*.g.dart
*.freezed.dart
*.config.dart

# ---- Secrets: never commit ----
# dev.json holds no secrets (empty keys, dev project) so it is committed and
# a fresh clone runs with no setup. Real keys only ever live in stg/prod.
config/stg.json
config/prod.json
# Per-machine debug settings, such as APP_CHECK_DEBUG_TOKEN: a registered
# debug token lets any debug build through App Check on the project.
config/local.json

# Firebase client config (firebase_options.dart, google-services.json,
# GoogleService-Info.plist) is deliberately NOT ignored. Those values are not
# secrets: they ship inside every published binary and are readable from any
# installed app. Security comes from the Firestore rules and App Check, not
# from hiding an API key. Ignoring them would only mean main.dart imports a
# file a fresh clone does not have, and the repo would not compile.
.firebase/
.env
.env.*
service-account*.json
*.jks
*.keystore
key.properties

# ---- Firebase emulator state ----
.emulator-data/
firebase-debug.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log

# ---- Node ----
node_modules/
functions/lib/
npm-debug.log*

# ---- Platform ----
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/ephemeral/
android/.gradle/
android/local.properties
android/key.properties
*.lock.hcl

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Local agent tooling ----
# Installed by the Firebase CLI, not part of the product. Commit these instead
# if the team wants everyone on the same skill versions.
.agents/
.claude/
skills-lock.json

# TypeScript build output
dist/

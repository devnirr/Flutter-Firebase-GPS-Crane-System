rules_version = '2';

// Grúas RD 24/7 — Storage access model.
//
// Nothing here is public. Every read a user makes goes through a short-lived
// signed URL minted by a Cloud Function, so a leaked path is not a leaked
// document — which matters because these are cédulas, licences and insurance
// certificates.
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Kept, unused, for the change that provisions App Check — the same state
    // firestore.rules is in. Requiring it before the clients can produce a
    // token refuses every upload the apps make (a 403 on the driver photo and
    // the licence alike) without raising the bar for anyone else. Put it back
    // into ok() together with firestore.rules and ENFORCE_APP_CHECK on the
    // functions, never on its own.
    function hasAppCheck() {
      return request.app != null;
    }

    function ok() {
      return isSignedIn();
    }

    function isStaff() {
      return ok() && request.auth.token.get('role', '') in ['admin', 'ops'];
    }

    // A phone camera photo is a couple of megabytes; 10 MB leaves room for a
    // scanned PDF without letting anyone use the bucket as free storage.
    function isReasonableSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/(jpeg|png|heic|webp)')
          || request.resource.contentType == 'application/pdf';
    }

    // Driver paperwork: the chofer uploads, the office reviews.
    match /drivers/{driverId}/docs/{fileName} {
      allow read: if isStaff() || (ok() && request.auth.uid == driverId);
      allow write: if (isStaff() || (ok() && request.auth.uid == driverId))
                   && isReasonableSize()
                   && isImageOrPdf();
    }

    // Profile photo. The roster and the customer's tracking screen show it
    // through the download URL `setDriverPhoto` stores, so unlike the
    // paperwork above it is only ever an image, and a small one.
    match /drivers/{driverId}/avatar/{fileName} {
      allow read: if isStaff() || (ok() && request.auth.uid == driverId);
      allow write: if (isStaff() || (ok() && request.auth.uid == driverId))
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Photos taken at pickup and dropoff. Written by the chofer assigned to
    // that service, as its Firestore record says, and nobody else: without
    // the check, any signed-in account could drop files into any job's
    // folder. Read access is granted through signed URLs, so no direct
    // client read.
    //
    // The Firestore lookup is a cross-service rule; the first deploy asks to
    // grant Storage permission to read Firestore.
    match /service_photos/{serviceId}/{fileName} {
      allow read: if isStaff();
      allow write: if ok() && isReasonableSize() && isImageOrPdf()
                   && firestore.exists(/databases/(default)/documents/services/$(serviceId))
                   && firestore.get(/databases/(default)/documents/services/$(serviceId)).data.get('driverId', '') == request.auth.uid;
    }

    // Photos of the vehicle a customer adds to a request, uploaded before the
    // service exists. The chofer offered the job sees them through the
    // download URL the request carries; as with chat photos, the random name
    // and the token in that URL are what keep them to the people concerned.
    match /requests/{clientId}/{fileName} {
      allow read: if isStaff() || (ok() && request.auth.uid == clientId);
      allow write: if ok() && request.auth.uid == clientId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    match /trucks/{truckId}/{fileName} {
      allow read: if ok();
      allow write: if isStaff() && isReasonableSize() && isImageOrPdf();
    }

    // Rendered invoices. Server-written, and even the owner reads them through
    // a signed URL rather than directly.
    match /invoices/{fileName} {
      allow read, write: if false;
    }

    // Photos shared inside a conversation — a job's chat or one opened from
    // the map before any job.
    //
    // Any signed-in user may read: Storage rules cannot see who the two
    // parties are, since that lives in Firestore. What stands in for it is
    // that the object id is random and the URL carries its own token, so a
    // photo is only reachable by someone the message was delivered to.
    // Writes are images only, and small — a chat is not a file store.
    match /chat/{threadId}/{fileName} {
      allow read: if ok();
      allow write: if ok()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|heic)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
